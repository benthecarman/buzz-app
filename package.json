{
  "name": "buzz-foundation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --force",
    "dev:desktop": "vite --strictPort --force",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "author:build": "node scripts/build-author.mjs",
    "plugin:claude-code": "vite build --config vite.claude-code.config.ts",
    "buzz-mcp": "vite build --config vite.buzz-mcp.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "tauri": "tauri",
    "lint": "biome lint --error-on-warnings . && node scripts/design-system/check-icons.mjs",
    "check": "biome check --error-on-warnings . && pnpm typecheck && pnpm design:typecheck && pnpm design:check",
    "buzzodz": "cargo run --quiet --manifest-path crates/plugin-manager/Cargo.toml --bin buzzodz --",
    "test": "node --test tests/integration/*.test.mjs && vitest run && cargo test -p buzzodz-plugins && pnpm test:browser",
    "test:browser": "playwright test --config tests/browser/playwright.config.mjs",
    "probe:live": "node --experimental-transform-types --no-warnings scripts/live-setup-probe.mjs",
    "test:browser:ci": "playwright test --config tests/browser/playwright.ci.config.mjs",
    "test:browser:local-only": "pnpm test:browser --project webkit-measurements --grep @local-webkit --no-deps --workers=1",
    "test:browser:install": "playwright install chromium webkit",
    "design:dev": "vite --config vite.design.config.ts",
    "design:build": "pnpm design:typecheck && vite build --config vite.design.config.ts && vite build --config vite.message-gallery.config.ts",
    "design:preview": "vite preview --config vite.design.config.ts",
    "design:typecheck": "tsc -p tsconfig.design.json",
    "design:check": "node scripts/design-system/check-type.mjs && node scripts/design-system/check-color.mjs && node scripts/design-system/check-contrast.mjs && node scripts/design-system/check-app-foundations.mjs && node scripts/design-system/check-icons.mjs && node scripts/design-system/check-adoption.mjs",
    "design:census": "node scripts/design-system/token-consumers.mjs",
    "design:test": "vitest run --config vitest.design.config.ts",
    "design:test:browser": "pnpm build && pnpm design:build && playwright test --config tests/fixtures/design-system/playwright.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@deepseek-ai/cordis": "4.0.2",
    "@dnd-kit/core": "6.3.1",
    "@emoji-mart/data": "1.2.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@jsquash/webp": "1.5.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@noble/curves": "2.0.1",
    "@tabler/icons": "3.46.0",
    "@tabler/icons-react": "3.46.0",
    "@tanstack/react-router": "^1.168.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-updater": "2.12.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "blurhash": "2.0.5",
    "consola": "3.4.2",
    "dockview-react": "8.3.1",
    "emoji-mart": "5.6.0",
    "flexlayout-react": "0.11.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm-strikethrough": "2.0.0",
    "mdast-util-gfm-table": "2.0.0",
    "mdast-util-to-markdown": "2.1.2",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "micromark-extension-gfm-table": "2.1.1",
    "motion": "12.40.0",
    "nostr-tools": "2.25.2",
    "prosemirror-commands": "1.7.1",
    "prosemirror-history": "1.5.0",
    "prosemirror-model": "1.25.4",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.41.8",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-diff-view": "3.3.2",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "virtua": "0.51.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "postcss": "8.5.28",
    "rolldown": "1.2.7",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "undici": "7.29.1",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
